; Engine configuration file.
; Godot 4.7, Forward+. Open this folder in the editor or run it with the Godot binary (see README.md).

config_version=5

[application]

config/name="Overgrowth"
config/description="Procedural anime plants growing over a town: ivy, bushes, trees and oaks, with streaming LOD."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[rendering]

anti_aliasing/quality/msaa_3d=2
textures/default_filters/anisotropic_filtering_level=3
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2

[shader_globals]

plant_time={
"type": "float",
"value": 0.0
}
main_cam={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
wind={
"type": "vec4",
"value": Vector4(0.8, 0.6, 1, 0)
}
grow={
"type": "float",
"value": 1.0
}
debug_lod={
"type": "float",
"value": 0.0
}
